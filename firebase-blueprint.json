{
  "entities": {
    "user": {
      "title": "User",
      "description": "User profile document",
      "type": "object",
      "properties": {
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "photoURL": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["email"]
    },
    "prediction": {
      "title": "Prediction",
      "description": "Air Quality Prediction record",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "modelId": { "type": "string" },
        "modelName": { "type": "string" },
        "inputData": { "type": "object" },
        "outputData": { "type": "object" },
        "status": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["userId", "modelName", "inputData", "outputData", "status"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "user",
      "description": "User profile document owned by user"
    },
    "/users/{userId}/predictions/{predictionId}": {
      "schema": "prediction",
      "description": "Air Quality Prediction history owned by user"
    }
  }
}
